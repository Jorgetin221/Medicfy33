// Models are added module by module, starting with M1 (identity),
// per the order of work in CLAUDE.md §4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─── M1 — Identidad, cuentas y sesión (spec §6.1, §7 M1) ───

enum UserStatus {
  PENDING_EMAIL
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

// PATIENT is the only role that never requires MFA (M1-RN-005).
enum RoleName {
  PATIENT
  DOCTOR
  ASSISTANT
  LAB
  SUPPORT
  ADMIN
  SUPERADMIN
  // Prompt 10 / P4 §6.5: rol curador de catálogos clínicos. El alta,
  // fusión y obsolescencia de términos de catálogo es un flujo aparte
  // de la captura clínica ("los catálogos son cerrados") y exige este
  // rol (o SUPERADMIN para el arranque). Ver CuratorGuard.
  CURATOR

  @@map("role_name")
}

enum ConsentType {
  PRIVACY_NOTICE
  SENSITIVE_DATA
  TELEMEDICINE
  DIGITAL_PRESCRIPTION_CHANNEL
  MARKETING

  @@map("consent_type")
}

// Minimal M1/M2 boundary: only what M1-RN-002 and M1-CA-003 need to gate
// clinical actions on verification status. Full profile, documents,
// locations and services arrive with M2.
enum DoctorVerificationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  VERIFIED
  // Parte B §5.2 [AGREGAR]: cédula profesional verificada, certificado
  // de especialidad todavía no. Opera con todo salvo que la
  // especialidad se muestre como verificada en perfil/documentos.
  VERIFIED_SPECIALTY_UNCONFIRMED
  REJECTED
  SUSPENDED

  @@map("doctor_verification_status")
}

enum VerificationChannel {
  EMAIL
  PHONE

  @@map("verification_channel")
}

enum AssistantInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("assistant_invitation_status")
}

enum AuditResult {
  SUCCESS
  DENIED

  @@map("audit_result")
}

model User {
  id                     String     @id @default(uuid())
  email                  String     @unique
  phoneE164              String?
  passwordHash           String
  primaryRole            RoleName
  status                 UserStatus @default(PENDING_EMAIL)
  emailVerifiedAt        DateTime?  @db.Timestamptz(3)
  phoneVerifiedAt        DateTime?  @db.Timestamptz(3)
  mfaEnabled             Boolean    @default(false)
  mfaSecretEncrypted     String?
  mfaBackupCodesHashed   String[]   @default([])
  // M1-RN-005: MFA becomes mandatory (for roles that require it) once
  // this counter reaches 3 successful logins without MFA enrolled.
  loginsWithoutMfa       Int        @default(0)
  // M1-RN-006: brute-force lockout. lockoutCount drives the exponential
  // backoff (15min * 2^lockoutCount), and resets on a successful login.
  failedLoginAttempts    Int        @default(0)
  lockedUntil            DateTime?  @db.Timestamptz(3)
  lockoutCount           Int        @default(0)
  lastLoginAt            DateTime?  @db.Timestamptz(3)
  lastLoginIp            String?
  acceptedTermsVersion   String?
  acceptedPrivacyVersion String?
  acceptedAt             DateTime?  @db.Timestamptz(3)
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(3)

  roles             UserRole[]
  consents          Consent[]
  sessions          Session[]
  doctor            Doctor?
  patient           Patient?
  invitations       AssistantInvitation[] @relation("InvitingDoctor")
  verificationCodes VerificationCode[]
  passwordResets    PasswordResetToken[]
  curatedTerms      ClinicalCatalogTerm[] @relation("CatalogTermCurator")
  termRequests      CatalogTermRequest[]  @relation("TermRequestRequester")
  curatedLabReferenceRanges LabReferenceRange[] @relation("LabReferenceRangeCurator")

  @@map("users")
}

// A user can hold several roles (M1-RN-001); scope_id lets a role be
// scoped to a clinic/lab when that becomes relevant (v1.1+).
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      RoleName
  scopeId   String?
  grantedBy String?
  grantedAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, role, scopeId])
  @@map("user_roles")
}

// Append-only per M1-RN-003/004 and R2: "el historial nunca se
// sobrescribe". Revoking consent is a new row with granted=false, never
// an UPDATE. Enforced at the PostgreSQL GRANT level in the migration
// (medicfy_app has only INSERT+SELECT here), same pattern as
// clinical_notes.
model Consent {
  id              String      @id @default(uuid())
  userId          String
  consentType     ConsentType
  documentVersion String
  granted         Boolean
  ipAddress       String
  userAgent       String
  evidenceHash    String
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("consents")
}

// M1-RN-007: access token 15 min (not persisted — stateless JWT).
// Refresh token is persisted, rotated on use, capped at 30 days
// absolute (expiresAt), and additionally subject to a role-based
// inactivity window enforced in application code (30 min for clinical
// roles, 7 days for patients) using lastUsedAt.
model Session {
  id                String    @id @default(uuid())
  userId            String
  refreshTokenHash  String    @unique
  deviceFingerprint String?
  ip                String?
  userAgent         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("sessions")
}

// M2 §6.3: full doctor profile. legalFirstName, legalLastName,
// professionalLicense, specialtyLicense and primarySpecialtyId are
// immutable once verificationStatus=VERIFIED (AUTH-RN-004, M2-RN-001,
// M2-CA-002) — enforced in DoctorProfileService, not here.
model Doctor {
  id                      String                   @id @default(uuid())
  userId                  String                   @unique
  legalFirstName          String
  legalLastName           String
  professionalLicense     String                   @unique
  specialtyLicense        String?
  // M2-RN-006: la cédula de especialidad (recertificación de consejo)
  // puede vencer — el sello "Médico verificado" se degrada cuando
  // pasa esta fecha (calculado al leer, en toPublicDoctorView, no vía
  // job). El recordatorio proactivo a 60 días queda PENDIENTE: exige
  // una cola real (Redis+BullMQ) que hoy no existe en el backend.
  specialtyLicenseExpiresAt DateTime?              @db.Timestamptz(3)
  primarySpecialtyId      String?
  // M5-RN-007: "el enlace público del médico (/dr/{slug})". Se genera
  // una sola vez al registrarse (auth.service.ts), no editable por el
  // médico en este pase.
  slug                    String                   @unique
  displayName             String?
  photoUrl                String?
  biography               String?
  // Parte B §5.1: datos de contacto que aparecen en el encabezado de
  // receta/orden — distintos del correo/teléfono de la cuenta (login),
  // que vive en User. Siempre editables (no son campos legales).
  professionalPhone       String?
  professionalEmail       String?
  // Parte B §1.2: "logo o frase de encabezado" — una u otra, nunca las
  // dos a la fuerza. logoUrl/signatureImageUrl guardan el fileKey
  // interno de FileStoragePort (mismo patrón que DoctorDocument.fileKey),
  // no una URL pública real todavía.
  letterheadPhrase        String?
  logoUrl                 String?
  signatureImageUrl       String?
  secondarySpecialtyIds   String[]                 @default([])
  yearsExperience         Int?
  languages               String[]                 @default([])
  university              String?
  verificationStatus      DoctorVerificationStatus @default(SUBMITTED)
  verificationNotes       String?
  verifiedByUserId        String?
  verifiedAt              DateTime?                @db.Timestamptz(3)
  // M2-RN-004: needs >=1 active location OR teleconsultation to
  // receive appointments — enforced in AppointmentStateMachineService.create().
  acceptsTeleconsultation Boolean                  @default(false)
  acceptsNewPatients      Boolean                  @default(true)
  // M4-RN-005: antelación mínima y ventana máxima de agenda,
  // configurables por médico. Editable via PATCH /doctors/me like any
  // other non-legal field (AUTH-RN-004: el médico sí edita "horarios").
  minBookingNoticeMinutes Int                      @default(120)
  maxBookingWindowDays    Int                      @default(90)
  // M5-RN-002: "configurable por médico". NULL means the spec's own
  // default applies (>24h 100%, 2-24h 50%, <2h/no-show 0%) — see
  // apps/api/.../cancellation-policy.ts for the shared shape/default,
  // used both here and to build each appointment's immutable
  // snapshot at creation (M5-CA-003).
  cancellationPolicy      Json?
  // Populated by M6 (billing) — placeholder columns only, per §6.3.
  subscriptionPlan        String?
  subscriptionStatus      String?
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)

  user                   User                    @relation(fields: [userId], references: [id])
  primarySpecialty       Specialty?              @relation(fields: [primarySpecialtyId], references: [id])
  documents              DoctorDocument[]
  locations              PracticeLocation[]
  services               DoctorService[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  careRelationships      CareRelationship[]
  appointments           Appointment[]
  encounters             ClinicalEncounter[]
  prescriptions          Prescription[]
  labOrders              LabOrder[]
  noteTemplates          NoteTemplate[]
  posts                  DoctorPost[]

  antecedentesTemplates AntecedentesTemplate[]
  selfAddedMedications  MedicationCatalog[]

  @@map("doctors")
}

// M8-RN-014 publishes schemas for exactly these four in v1.0; the
// catalog itself (M2) is broader in principle but seeded with only
// these per YAGNI — more rows are just data, not a migration.
model Specialty {
  id                       String   @id @default(uuid())
  code                     String   @unique
  nameEs                   String
  cieGroup                 String?
  isActive                 Boolean  @default(true)
  requiresSpecialtyLicense Boolean  @default(true)
  createdAt                DateTime @default(now()) @db.Timestamptz(3)

  doctors      Doctor[]
  fieldSchemas SpecialtyFieldSchema[]
  treatmentProtocols TreatmentProtocol[]

  antecedentesTemplates AntecedentesTemplate[]

  @@map("specialties")
}

enum DoctorDocumentType {
  CEDULA_PROFESIONAL
  CEDULA_ESPECIALIDAD
  INE
  CV
  CERTIFICADO_CONSEJO
  COMPROBANTE_DOMICILIO

  @@map("doctor_document_type")
}

enum DoctorDocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("doctor_document_review_status")
}

// M2-CA-003: admin verification queue reviews these, hash included.
model DoctorDocument {
  id              String                     @id @default(uuid())
  doctorId        String
  docType         DoctorDocumentType
  fileKey         String
  fileHashSha256  String
  uploadedAt      DateTime                   @default(now()) @db.Timestamptz(3)
  reviewStatus    DoctorDocumentReviewStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?                  @db.Timestamptz(3)
  rejectionReason String?

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@map("doctor_documents")
}

model PracticeLocation {
  id                  String   @id @default(uuid())
  doctorId            String
  name                String
  addressStreet       String?
  addressExt          String?
  addressInt          String?
  addressColonia      String?
  addressMunicipality String?
  addressState        String?
  addressPostalCode   String?
  latitude            Float?
  longitude           Float?
  phone               String?
  isPrimary           Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  doctor            Doctor             @relation(fields: [doctorId], references: [id])
  services          DoctorService[]
  availabilityRules AvailabilityRule[]
  appointments      Appointment[]

  @@map("practice_locations")
}

enum ServiceType {
  FIRST_VISIT
  FOLLOW_UP
  TELECONSULTATION
  PROCEDURE

  @@map("service_type")
}

// M2-RN-003: prices are private by default, never in a public
// response (M2-CA-001) — enforced by never including them in any
// public-facing serializer, not by a DB-level mechanism.
enum PriceVisibility {
  PRIVATE
  SHARED_ON_BOOKING

  @@map("price_visibility")
}

model DoctorService {
  id              String          @id @default(uuid())
  doctorId        String
  locationId      String?
  serviceType     ServiceType
  name            String
  durationMinutes Int
  // CLAUDE.md §4: "Dinero: enteros en centavos, nunca float."
  priceMxnCents   Int
  currency        String          @default("MXN")
  priceVisibility PriceVisibility @default(PRIVATE)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  location     PracticeLocation? @relation(fields: [locationId], references: [id])
  appointments Appointment[]

  @@map("doctor_services")
}

// M2B (spec §7, v2.2): categoría cerrada, independiente de la
// audiencia (visibility) y del estado (status) de la publicación.
enum PostCategory {
  HEALTH_EDUCATION
  HEALTH_TIP
  HEALTH_FACT
  PROFESSIONAL_UPDATE
  CONGRESS
  RESEARCH
  CERTIFICATION
  PATIENT_NOTICE
  PREVENTION
  LIFESTYLE
  VIDEO
  PHOTO
  ANNOUNCEMENT

  @@map("post_category")
}

// M2B-RN-002: quién puede ver la publicación — autorizado siempre en
// backend (toPublicDoctorView-style: el serializador decide, nunca el
// cliente). PATIENTS_ONLY exige care_relationship activo; hoy no hay
// portal de pacientes que llame esa ruta, pero la regla ya es real.
enum PostVisibility {
  PUBLIC
  PATIENTS_ONLY
  PRIVATE

  @@map("post_visibility")
}

// M2B-RN-003: draft (solo el autor) -> published (según visibility) ->
// archived (fuera de toda vista pública/pacientes, el autor la
// conserva). No es dato clínico (R1 no aplica) — DELETE real existe.
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("post_status")
}

enum PostMediaType {
  PHOTO
  VIDEO

  @@map("post_media_type")
}

model DoctorPost {
  id               String         @id @default(uuid())
  doctorId         String
  title            String?
  body             String
  category         PostCategory
  visibility       PostVisibility @default(PRIVATE)
  status           PostStatus     @default(DRAFT)
  publishedAt      DateTime?      @db.Timestamptz(3)
  archivedAt       DateTime?      @db.Timestamptz(3)
  // Quién archivó, cuando no fue el propio autor (M2B-RN-008,
  // moderación mínima de un ADMIN).
  archivedByUserId String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  doctor Doctor            @relation(fields: [doctorId], references: [id])
  media  DoctorPostMedia[]

  @@map("doctor_posts")
}

model DoctorPostMedia {
  id           String        @id @default(uuid())
  postId       String
  mediaType    PostMediaType
  fileKey      String
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  post DoctorPost @relation(fields: [postId], references: [id])

  @@map("doctor_post_media")
}

enum AppointmentModality {
  IN_PERSON
  ONLINE

  @@map("appointment_modality")
}

// M4 §6.4: recurrencia semanal. weekday sigue la convención de
// JS Date#getDay() (0=domingo..6=sábado) para evitar una traducción
// extra entre el borde de la API y el cómputo de espacios en el
// servidor. start/endMinute son minutos desde medianoche LOCAL
// (America/Mexico_City, sin fecha ni zona horaria en el dato mismo —
// M4-RN-001 exige que el cálculo de horario nunca ocurra en el
// navegador, no que el dato cargue su propia zona) — evita las
// ambigüedades de un tipo TIME de Postgres serializado por el driver.
model AvailabilityRule {
  id                  String              @id @default(uuid())
  doctorId            String
  locationId          String?
  modality            AppointmentModality
  weekday             Int
  startMinute         Int
  endMinute           Int
  slotDurationMinutes Int
  bufferMinutes       Int                 @default(0)
  validFrom           DateTime            @db.Date
  validUntil          DateTime?           @db.Date
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)

  doctor   Doctor            @relation(fields: [doctorId], references: [id])
  location PracticeLocation? @relation(fields: [locationId], references: [id])

  @@map("availability_rules")
}

// M4 §6.4: bloqueos y vacaciones. startAt/endAt are TIMESTAMPTZ,
// unlike AvailabilityRule's weekly recurrence fields, because an
// exception is a one-off instant in time, not a wall-clock pattern.
model AvailabilityException {
  id           String   @id @default(uuid())
  doctorId     String
  startAt      DateTime @db.Timestamptz(3)
  endAt        DateTime @db.Timestamptz(3)
  reason       String?
  blocksAllDay Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@map("availability_exceptions")
}

// ─── M5a — Pacientes y citas (núcleo) ───

enum PatientSource {
  SELF_SIGNUP
  CREATED_BY_DOCTOR

  @@map("patient_source")
}

enum SexAtBirth {
  F
  M

  @@map("sex_at_birth")
}

// M5-RN-008: birthDate/sexAtBirth/phoneE164/email are the minimum
// required at registration ("nombre, teléfono, email, fecha de
// nacimiento") — everything address/emergency-contact is optional,
// same pattern as PracticeLocation's address fields. medicfyId is
// generated from the patients_medicfy_id_seq sequence (see migration)
// — a Postgres sequence, not app-level counting, so it stays correct
// under concurrent patient creation.
model Patient {
  id                       String        @id @default(uuid())
  userId                   String?       @unique
  medicfyId                String        @unique
  firstName                String
  lastNamePaternal         String
  lastNameMaternal         String?
  birthDate                DateTime      @db.Date
  sexAtBirth               SexAtBirth
  genderIdentity           String?
  curp                     String?
  bloodType                String?
  phoneE164                String
  email                    String
  addressStreet            String?
  addressExt               String?
  addressInt               String?
  addressColonia           String?
  addressMunicipality      String?
  addressState             String?
  addressPostalCode        String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  createdByUserId          String?
  source                   PatientSource
  createdAt                DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime      @updatedAt @db.Timestamptz(3)

  user              User?                @relation(fields: [userId], references: [id])
  guardians         PatientGuardian[]
  careRelationships CareRelationship[]
  appointments      Appointment[]
  allergies         PatientAllergy[]
  medications       PatientMedication[]
  historyItems      PatientHistoryItem[]
  pregnancies       PatientPregnancy[]
  substanceUses     PatientSubstanceUse[]
  gynecoHistory     PatientGynecoHistory?
  vitalSignSets     VitalSignSet[]
  encounters        ClinicalEncounter[]
  attachments       ClinicalAttachment[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  labResults        LabResult[]
  labResultAnalytes LabResultAnalyte[]
  labSheetExtractions LabSheetExtraction[]
  protocolInstances PatientProtocolInstance[]

  @@map("patients")
}

enum GuardianRelation {
  MADRE
  PADRE
  TUTOR_LEGAL
  OTRO

  @@map("guardian_relation")
}

// §6.4 "Menor de edad" caso límite: obligatorio en alcance (piloto de
// pediatría). El vínculo `guardianship` que ese texto describe ES esta
// fila — no hay un modelo separado. La revocación automática al
// cumplir 18 años (también en ese texto) se aplica en el momento del
// acceso, no por un job de calendario — no hay BullMQ conectado
// todavía (ver docs/CRITERIOS_DIFERIDOS.md, M2-CA-008), y comprobar
// en el momento del acceso es correcto incluso sin scheduler: nunca
// hay una ventana donde un tutor de un paciente que ya cumplió 18
// años pase la verificación. Ver GuardianAccessService.
model PatientGuardian {
  id                    String           @id @default(uuid())
  patientId             String
  guardianName          String
  guardianRelation      GuardianRelation
  guardianCurp          String?
  guardianPhoneE164     String
  guardianEmail         String
  // INE del tutor, cifrado — mismo mecanismo que DoctorDocument
  // (FileStoragePort), solo la referencia vive aquí.
  guardianIdDocumentKey String
  consentGrantedAt      DateTime         @db.Timestamptz(3)
  isPrimary             Boolean          @default(false)
  revokedAt             DateTime?        @db.Timestamptz(3)
  revokedReason         String?
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("patient_guardians")
}

enum CareRelationshipStatus {
  ACTIVE
  EXPIRED
  REVOKED

  @@map("care_relationship_status")
}

enum CareRelationshipOrigin {
  APPOINTMENT
  PATIENT_GRANTED
  CREATED_BY_DOCTOR

  @@map("care_relationship_origin")
}

// AUTH-RN-001: origin de las tres vías permitidas; expiresAt a 18
// meses desde lastInteractionAt, revisado en el momento del acceso
// (mismo patrón que PatientGuardian — sin scheduler todavía).
model CareRelationship {
  id                String                 @id @default(uuid())
  patientId         String
  doctorId          String
  status            CareRelationshipStatus @default(ACTIVE)
  origin            CareRelationshipOrigin
  startedAt         DateTime               @default(now()) @db.Timestamptz(3)
  lastInteractionAt DateTime               @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime               @db.Timestamptz(3)
  revokedAt         DateTime?              @db.Timestamptz(3)
  revokedBy         String?

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@map("care_relationships")
}

enum AppointmentStatus {
  PENDING_PAYMENT
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_DOCTOR
  NO_SHOW

  @@map("appointment_status")
}

enum AppointmentCreatedVia {
  DOCTOR_PANEL
  ASSISTANT
  PATIENT_LINK
  PUBLIC_DIRECTORY

  @@map("appointment_created_via")
}

// §6.4. La restricción EXCLUDE USING gist (M4-CA-001, doble
// agendamiento) se agrega a mano en la migración — Prisma no puede
// expresarla en schema.prisma. paymentDeadlineAt/no-show: sin
// scheduler todavía, se aplican como barrido perezoso (mismo patrón
// que PatientGuardian/CareRelationship), no un cron real — ver
// AppointmentStateMachineService.
model Appointment {
  id                         String                @id @default(uuid())
  patientId                  String
  doctorId                   String
  locationId                 String?
  serviceId                  String
  modality                   AppointmentModality
  startsAt                   DateTime              @db.Timestamptz(3)
  endsAt                     DateTime              @db.Timestamptz(3)
  timezone                   String                @default("America/Mexico_City")
  status                     AppointmentStatus     @default(PENDING_PAYMENT)
  createdByUserId            String
  createdVia                 AppointmentCreatedVia
  priceMxnCents              Int
  // Populated by M6 (billing) — placeholder column, per §6.3's own
  // pattern for fields a not-yet-built module will own.
  paymentReference           String?
  paymentDeadlineAt          DateTime?             @db.Timestamptz(3)
  videoRoomUrl               String?
  videoProviderRef           String?
  cancellationReason         String?
  cancelledAt                DateTime?             @db.Timestamptz(3)
  cancelledByUserId          String?
  reminder24hSentAt          DateTime?             @db.Timestamptz(3)
  reminder2hSentAt           DateTime?             @db.Timestamptz(3)
  rescheduledFromId          String?               @unique
  // M5-RN-004: máximo 2 reagendas por cita — cuenta heredada +1 en
  // cada reagenda, validada contra el tope en el servicio.
  rescheduleCount            Int                   @default(0)
  // M5-RN-002/M5-CA-003: snapshot inmutable de la política vigente al
  // momento de crear la cita — nunca se resuelve por join a
  // doctors.cancellationPolicy después.
  cancellationPolicySnapshot Json
  // M5-RN-006: excepción explícita del texto de la spec — "consulta
  // sin nota" con justificación. M8 (nota clínica firmada) no existe
  // todavía, así que hoy esta es la ÚNICA ruta a completed; cuando M8
  // exista, la ruta real (nota firmada) se vuelve la primaria y esta
  // queda como la excepción documentada que la spec ya preveía.
  completedWithoutNoteReason String?
  createdAt                  DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime              @updatedAt @db.Timestamptz(3)

  patient         Patient                    @relation(fields: [patientId], references: [id])
  doctor          Doctor                     @relation(fields: [doctorId], references: [id])
  location        PracticeLocation?          @relation(fields: [locationId], references: [id])
  service         DoctorService              @relation(fields: [serviceId], references: [id])
  rescheduledFrom Appointment?               @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment?               @relation("AppointmentReschedule")
  statusHistory   AppointmentStatusHistory[]
  encounter       ClinicalEncounter?

  @@map("appointments")
}

// M5-RN-001: "Toda transición se registra... sin excepciones" — mismo
// mecanismo de solo-INSERT+SELECT bajo GRANT que clinical_notes,
// consents y audit_log (M15-RN-001), aplicado aquí porque la propia
// spec llama append-only a esta tabla en §6.4, no porque R1 la
// nombre literalmente (R1 nombra 4 tablas; el mecanismo ya se aplicó
// antes a consents, que tampoco está en esa lista literal).
model AppointmentStatusHistory {
  id              String             @id @default(uuid())
  appointmentId   String
  fromStatus      AppointmentStatus?
  toStatus        AppointmentStatus
  changedByUserId String?
  reason          String?
  changedAt       DateTime           @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("appointment_status_history")
}

// M1-RN-008: up to 3 pending invitations per doctor, 72h expiry —
// enforced in application code (AssistantInvitationService).
model AssistantInvitation {
  id               String                    @id @default(uuid())
  doctorUserId     String
  email            String
  token            String                    @unique
  status           AssistantInvitationStatus @default(PENDING)
  expiresAt        DateTime                  @db.Timestamptz(3)
  acceptedAt       DateTime?                 @db.Timestamptz(3)
  acceptedByUserId String?
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)

  doctorUser User @relation("InvitingDoctor", fields: [doctorUserId], references: [id])

  @@map("assistant_invitations")
}

// Registration flow step 2: 6-digit code, 10 min validity.
model VerificationCode {
  id         String              @id @default(uuid())
  userId     String
  channel    VerificationChannel
  codeHash   String
  expiresAt  DateTime            @db.Timestamptz(3)
  consumedAt DateTime?           @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("verification_codes")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

// M1-scoped subset of spec §6.9. Hash-chaining columns
// (prev_entry_hash/entry_hash) arrive with M15. No FK to users:
// audit_log must accept an entry even when the actor can't be
// resolved (e.g. a login attempt against an email that doesn't
// exist), matching the spec's own polymorphic resource_type/
// resource_id design. Append-only per M15-RN-001, same GRANT pattern
// as consents and clinical_notes.
model AuditLog {
  id            String      @id @default(uuid())
  actorUserId   String?
  actorRole     String?
  action        String
  resourceType  String
  resourceId    String?
  // M8 (§7.15/R3): columna dedicada, no enterrada en metadata — la
  // matriz de permisos exige que un médico pueda consultar "bitácora
  // de accesos a sus pacientes" de forma eficiente. Sin @relation,
  // mismo motivo que actorUserId: audit_log debe aceptar la fila
  // aunque el paciente referenciado ya no se pueda resolver.
  patientId     String?
  ipAddress     String?
  userAgent     String?
  requestId     String?
  justification String?
  result        AuditResult
  metadata      Json?
  occurredAt    DateTime    @default(now()) @db.Timestamptz(3)

  @@index([patientId])
  @@map("audit_log")
}

// ─── M8 — Expediente clínico electrónico (spec §6.5, NOM-004) ───
//
// Reemplaza el placeholder ClinicalNote que existía antes de este
// cambio (probaba solo el mecanismo append-only vía GRANT). Mismo
// mecanismo aplicado aquí a clinical_notes, prescriptions y
// lab_orders — ver la migración de este cambio para las sentencias
// GRANT/REVOKE.

enum EncounterType {
  FIRST_VISIT
  FOLLOW_UP
  TELECONSULTATION
  URGENT

  @@map("encounter_type")
}

enum EncounterStatus {
  DRAFT
  SIGNED

  @@map("encounter_status")
}

enum SignatureMethod {
  // M9-RN-009/§3.2: única implementación construida en este pase.
  INTERNAL_SYSTEM
  // Variante del enum sin implementación detrás — bloqueada por
  // decisión legal pendiente (spec congelada §3.2).
  ADVANCED_EFIRMA

  @@map("signature_method")
}

// M8-RN-002: draft autoguardado cada 10s, editable libremente. Al
// firmar se congela: se calcula contentHashSha256 y se encadena con
// previousHashSha256 del encuentro firmado anterior del mismo paciente
// (M8-CA-004). M8-RN-003: un draft sin firmar >72h se marca abandonado,
// evaluado en el momento del acceso — sin scheduler todavía, mismo
// patrón que CareRelationship/PatientGuardian.
model ClinicalEncounter {
  id                 String           @id @default(uuid())
  patientId          String
  doctorId           String
  appointmentId      String?          @unique
  encounterType      EncounterType
  // M8-RN-002: aquí vive el autoguardado mientras status=DRAFT — no
  // en clinical_notes, que el GRANT de Postgres ya vuelve
  // verdaderamente append-only (ni siquiera medicfy_app puede
  // UPDATE-earla). ClinicalNote se inserta una sola vez, completa, al
  // firmar (ver ClinicalEncounterService.sign).
  draftContent       Json             @default("{}")
  status             EncounterStatus  @default(DRAFT)
  startedAt          DateTime         @default(now()) @db.Timestamptz(3)
  endedAt            DateTime?        @db.Timestamptz(3)
  signedAt           DateTime?        @db.Timestamptz(3)
  // M8-RN-013: "el sistema mide el tiempo entre abrir y firmar cada
  // nota — es la métrica del negocio, no telemetría opcional". Se fija
  // al firmar como signedAt - startedAt, en servidor. Es tiempo de
  // reloj de pared: un borrador retomado días después la infla, y ese
  // caso queda visible en vez de esconderse en un promedio.
  timeToSignSeconds  Int?
  signedByUserId     String?
  signatureMethod    SignatureMethod?
  // Fase 6 · Prompt 43: "estampa nombre completo, cédula profesional"
  // — snapshot al momento de firmar (R6), nunca resuelto por join
  // después. Mismo patrón que LabOrder.doctorNameSnapshot/
  // doctorLicenseSnapshot.
  signedByLegalNameSnapshot String?
  signedByLicenseSnapshot  String?
  contentHashSha256  String?
  previousHashSha256 String?
  abandonedAt        DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  patient       Patient                 @relation(fields: [patientId], references: [id])
  doctor        Doctor                  @relation(fields: [doctorId], references: [id])
  appointment   Appointment?            @relation(fields: [appointmentId], references: [id])
  notes         ClinicalNote[]
  diagnoses     EncounterDiagnosis[]
  attachments   ClinicalAttachment[]
  prescriptions Prescription[]
  labOrders     LabOrder[]
  specialtyData EncounterSpecialtyData?
  protocolSessions ProtocolSession[]
  assistantReadings AssistantReading[]
  redFlagEvents RedFlagEvent[]

  @@map("clinical_encounters")
}

// Estructura NOM-004 mínima. NO HAY UPDATE. NO HAY DELETE (M8-RN-001)
// — corregir = nueva fila con isCorrectionOfNoteId apuntando a la
// anterior; la interfaz muestra ambas, marcando la corrección.
// Prompt 25 — FHIR (R7) campo por campo: la nota es un
// Composition/ClinicalImpression: chiefComplaint → Encounter.reason /
// Observation "chief complaint"; currentIllness (SUBJETIVO, texto
// libre permitido por R3) → Composition.section[subjective];
// physicalExam (OBJETIVO) → section[objective]; assessment (ANÁLISIS,
// texto libre por R3) → ClinicalImpression.summary; plan →
// CarePlan.description; vitals → ver VitalSignSet (Observation
// vital-signs); noteTypeTermId → Composition.type (catálogo
// TIPO_NOTA); specialtyCode → Composition.author.specialty;
// isCorrectionOfNoteId (adenda) → Composition.relatesTo(replaces).
// Estados: borrador vive en el encounter (draftContent); firmada =
// esta fila; con adenda = corrections[]; "cancelada" no existe para
// una nota firmada (R1) — se corrige, nunca se cancela.
model ClinicalNote {
  id                   String   @id @default(uuid())
  encounterId          String
  // Prompt 25: tipo de nota TOMADO DEL CATÁLOGO (dominio TIPO_NOTA) y
  // especialidad del autor como snapshot — fijados por el servidor al
  // firmar, nunca por el cliente.
  noteTypeTermId       String?
  specialtyCode        String?
  chiefComplaint       String
  currentIllness       String
  // Prompt 37B: lo que el PACIENTE se lleva — lenguaje llano,
  // separado de la nota técnica; se imprime como PDF propio.
  patientInstructions  String?
  // Prompt 37C: próxima cita sugerida desde el plan (días).
  suggestedFollowUpDays Int?
  vitals               Json
  physicalExam         String?
  assessment           String
  plan                 String
  prognosis            String?
  isCorrectionOfNoteId String?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  encounter          ClinicalEncounter    @relation(fields: [encounterId], references: [id])
  isCorrectionOfNote ClinicalNote?        @relation("NoteCorrection", fields: [isCorrectionOfNoteId], references: [id])
  corrections        ClinicalNote[]       @relation("NoteCorrection")
  noteTypeTerm       ClinicalCatalogTerm? @relation("NoteTypeTerm", fields: [noteTypeTermId], references: [id])
  vitalSignSet       VitalSignSet?
  cancellation       ClinicalNoteCancellation?
  labResults         NoteLabResult[]

  @@map("clinical_notes")
}

// Fase 6 · Prompt 44B: "el registro se marca cancelado, NUNCA se
// elimina, y sigue siendo consultable." Mismo patrón exacto que
// PrescriptionCancellation/LabOrderCancellation — tabla separada,
// solo INSERT+SELECT (clinical_notes ya es append-only por su propio
// GRANT; esta tabla nunca se UPDATEa tampoco). Su sola existencia ES
// el estado "cancelada".
model ClinicalNoteCancellation {
  id                String   @id @default(uuid())
  noteId            String   @unique
  reasonTermId      String
  reasonFreeText    String?
  cancelledByUserId String
  cancelledAt       DateTime @default(now()) @db.Timestamptz(3)

  note       ClinicalNote        @relation(fields: [noteId], references: [id])
  reasonTerm ClinicalCatalogTerm @relation("NoteCancellationReasonTerm", fields: [reasonTermId], references: [id])

  @@map("clinical_note_cancellations")
}

// Prompt 26 — signos vitales como ENTIDAD por nota, no campos de
// texto: cada medida en su columna con la unidad EXPLÍCITA en el
// nombre. Presión sistólica y diastólica SEPARADAS (en el sistema de
// referencia eran un campo de texto y por eso no se podía graficar ni
// detectar una crisis hipertensiva).
// FHIR (R7): Observation vital-signs — 8480-6 sistólica, 8462-4
// diastólica, 8867-4 FC, 9279-1 FR, 8310-5 temperatura, 59408-5 SpO2,
// 29463-7 peso, 8302-2 talla, 9843-4 perímetro cefálico, 8280-0
// perímetro abdominal (códigos LOINC).
// outOfRangeFlags/criticalFlags: nombres de campo evaluados contra
// rangos por edad (vital-ranges.util.ts, fuentes citadas ahí); un
// valor crítico exigió confirmación explícita del médico al firmar.
model VitalSignSet {
  id                       String   @id @default(uuid())
  noteId                   String   @unique
  encounterId              String
  patientId                String
  bpSystolicMmHg           Int?
  bpDiastolicMmHg          Int?
  heartRateBpm             Int?
  respiratoryRateBpm       Int?
  temperatureC             Decimal? @db.Decimal(4, 1)
  spo2Percent              Int?
  // Fase 8 · Prompt 52 (banderas rojas): no existía captura de glucosa
  // capilar ni llenado capilar en ningún lugar del sistema hasta ahora
  // — ambas las pide explícitamente el documento clínico del médico
  // responsable (banderas por glucosa fuera de rango y por llenado
  // capilar > 3s). Mismo patrón que el resto de vitales: opcionales,
  // sin cálculo del servidor.
  glucoseCapMgDl           Int?
  capillaryRefillSeconds   Decimal? @db.Decimal(3, 1)
  weightKg                 Decimal? @db.Decimal(6, 2)
  heightCm                 Decimal? @db.Decimal(5, 1)
  headCircumferenceCm      Decimal? @db.Decimal(5, 1)
  abdominalCircumferenceCm Decimal? @db.Decimal(5, 1)
  // Prompt 27: calculados SIEMPRE en servidor, con fórmula y versión.
  bmi                      Decimal? @db.Decimal(4, 1)
  bmiFormula               String?
  bsaM2                    Decimal? @db.Decimal(4, 2)
  bsaFormula               String?
  weightPercentile         Decimal? @db.Decimal(5, 2)
  heightPercentile         Decimal? @db.Decimal(5, 2)
  percentileSource         String?
  outOfRangeFlags          String[] @default([])
  criticalFlags            String[] @default([])
  recordedAt               DateTime @default(now()) @db.Timestamptz(3)

  note    ClinicalNote @relation(fields: [noteId], references: [id])
  patient Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId, recordedAt])
  @@map("vital_sign_sets")
}

// v2.5 — Capa 3. Mismo patrón exacto que VitalSignSet: congelado en
// sign() (ClinicalEncounterService), nunca editable después —
// append-only real (ver GRANT), igual que clinical_notes. 1:muchos
// (un vital_sign_sets por nota; aquí una nota puede incluir varios
// analitos) — el médico elige cuáles con
// draftContent.labResultAnalyteIds antes de firmar. status/rangeSource
// son el resultado ya congelado de evaluateLabValue() en el momento
// de la firma — la nota firmada nunca vuelve a recalcularlos aunque
// lab_reference_ranges cambie después.
model NoteLabResult {
  id               String              @id @default(uuid())
  noteId           String
  sourceAnalyteId  String
  analyteName      String
  value            Decimal             @db.Decimal(10, 3)
  unit             String
  referenceMin     Decimal?            @db.Decimal(10, 3)
  referenceMax     Decimal?            @db.Decimal(10, 3)
  rangeSource      LabRangeSource
  status           LabValueStatus
  // measuredAt ES la fecha del estudio (mismo campo que ya trae
  // LabResultAnalyte) — sin una columna resultDate separada y
  // redundante.
  measuredAt       DateTime            @db.Timestamptz(3)
  labName          String?
  source           LabResultAnalyteSource
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)

  note           ClinicalNote     @relation(fields: [noteId], references: [id])
  sourceAnalyte  LabResultAnalyte @relation(fields: [sourceAnalyteId], references: [id])

  @@index([noteId])
  @@map("note_lab_results")
}

enum LabRangeSource {
  SHEET
  SYSTEM
  NONE

  @@map("lab_range_source")
}

enum LabValueStatus {
  NORMAL
  LOW
  HIGH
  CRITICAL
  UNKNOWN

  @@map("lab_value_status")
}

// Prompt 27/30 — referencias LMS de crecimiento (OMS 2006 0-60 meses,
// CDC 2000 24-240 meses), tal como las redistribuye pygrowup 0.8.2.
// percentil = Φ(((valor/M)^L − 1) / (L·S)). Datos en
// prisma/data/growth-lms.json; verificado: la mediana OMS (9.6479 kg,
// niños 12 meses) produce exactamente P50.
model GrowthReference {
  id        String  @id @default(uuid())
  sex       String
  measure   String
  ageMonths Decimal @db.Decimal(6, 2)
  l         Decimal @db.Decimal(12, 8)
  m         Decimal @db.Decimal(12, 6)
  s         Decimal @db.Decimal(12, 8)
  source    String

  @@unique([sex, measure, ageMonths, source])
  @@map("growth_references")
}

enum DiagnosisType {
  PRINCIPAL
  SECONDARY

  @@map("diagnosis_type")
}

enum DiagnosisCertainty {
  SUSPECTED
  CONFIRMED
  // Prompt 28: descartar un diagnóstico no lo borra — cambia su tipo
  // y conserva el histórico (R1). discardedAt/discardedByUserId abajo.
  DESCARTADO

  @@map("diagnosis_certainty")
}

// M8-RN-006: diagnóstico principal obligatorio con CIE-10 para firmar.
// icd10Code es nullable a propósito: M8-RN-006 exige código CIE-10
// para el diagnóstico principal, y "texto libre permitido como
// complemento, nunca como sustituto" — pero a petición explícita del
// usuario (2026-08-24), que confirmó apartarse de esa regla a
// sabiendas, existe una segunda ruta cuando de verdad no hay código
// aplicable: codeAbsentReason queda como la justificación auditable
// de esa decisión. Exactamente uno de los dos siempre está presente
// (icd10Code o codeAbsentReason), nunca ambos ni ninguno — validado
// en encounterDiagnosisSchema (contracts), no aquí.
// Prompt 28 — FHIR (R7): Condition. icd10CodeId → Condition.code
// (ICD-10); certainty → verificationStatus (SUSPECTED=provisional,
// CONFIRMED=confirmed, DESCARTADO=refuted); createdAt →
// recordedDate; el autor es el firmante del encuentro.
// Codificación COMPUESTA futura sin cambiar el esquema: el modelo ya
// es fila-por-código dentro del encuentro (PRINCIPAL + N SECONDARY);
// un código adicional por especialidad es otra fila SECONDARY cuyo
// icd10CodeId apunta al código complementario — no hace falta columna
// nueva, solo la convención (documentada aquí) de agrupar por
// encounterId.
model EncounterDiagnosis {
  id                 String             @id @default(uuid())
  encounterId        String
  icd10Code          String?
  // Prompt 28 / P4 §2.4: FK real — un código que no existe en el
  // catálogo ya no puede quedar firmado y hasheado en el expediente.
  icd10CodeId        String?
  codeAbsentReason   String?
  description        String
  diagnosisType      DiagnosisType
  certainty          DiagnosisCertainty
  discardedAt        DateTime?          @db.Timestamptz(3)
  discardedByUserId  String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id])
  icd10Ref  Icd10Code?        @relation(fields: [icd10CodeId], references: [code])

  @@map("encounter_diagnoses")
}

enum ClinicalAttachmentCategory {
  LAB_RESULT
  IMAGING
  EXTERNAL_DOCUMENT
  PHOTO
  OTHER

  @@map("clinical_attachment_category")
}

// M8-RN-010: cifrado en reposo + URL prefirmada ≤5 min vía
// FileStoragePort — mismo puerto cerrado en el pase de Perfil, sin
// cambios aquí.
model ClinicalAttachment {
  id               String                     @id @default(uuid())
  patientId        String
  encounterId      String?
  fileKey          String
  fileName         String
  fileHashSha256   String
  mimeType         String
  sizeBytes        Int
  category         ClinicalAttachmentCategory
  // Fase 5 · Prompt 41: fecha del estudio, distinta de uploadedAt (el
  // documento puede subirse días después de realizado). Opcional
  // porque no todo adjunto (p. ej. una foto clínica) tiene una fecha
  // de estudio propia.
  studyDate        DateTime?                  @db.Timestamptz(3)
  uploadedByUserId String
  description      String?
  uploadedAt       DateTime                   @default(now()) @db.Timestamptz(3)

  patient   Patient            @relation(fields: [patientId], references: [id])
  encounter ClinicalEncounter? @relation(fields: [encounterId], references: [id])

  @@map("clinical_attachments")
}

// CLAUDE.md §6/DOC-06: "plantillas insertables por atajo de teclado".
// content lo escribe siempre el médico dueño — nunca texto clínico
// precargado por Medicfy (CLAUDE.md §7). No es append-only (no está
// en la lista literal de R1): es texto reusable del médico, no un
// registro clínico del paciente.
model NoteTemplate {
  id          String   @id @default(uuid())
  doctorId    String
  label       String
  content     String
  shortcutKey String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, shortcutKey])
  @@map("note_templates")
}

enum AllergyStatus {
  ACTIVE
  INACTIVE
  RULED_OUT

  @@map("allergy_status")
}

enum AllergyCertainty {
  CONFIRMED
  LIKELY
  UNCERTAIN

  @@map("allergy_certainty")
}

// M8-RN-008: cruzada automáticamente contra cada prescripción
// (M9-RN-008a). Vive en el paciente, no en el encuentro — se captura
// una vez y se arrastra (M8-RN-012).
// Prompt 23A (FHIR R7): AllergyIntolerance — catalogTermId →
// AllergyIntolerance.code; medicationCatalogId ancla las alergias a
// fármaco al catálogo de medicamentos para el cruce de la Fase 4;
// severity → reaction.severity; certainty → verificationStatus.
model PatientAllergy {
  id             String           @id @default(uuid())
  patientId      String
  // FK al catálogo ALERGIA_AGENTE (nullable por filas previas).
  catalogTermId        String?
  // Para alergias a fármaco: ancla al catálogo de medicamentos.
  medicationCatalogId  String?
  substance      String
  allergyType    String
  reaction       String?
  severity       String
  ageOfOnset     String?
  status         AllergyStatus    @default(ACTIVE)
  certainty      AllergyCertainty
  source         String
  lastReviewedAt DateTime         @default(now()) @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  patient           Patient              @relation(fields: [patientId], references: [id])
  catalogTerm       ClinicalCatalogTerm? @relation("AllergyTerm", fields: [catalogTermId], references: [id])
  medicationCatalog MedicationCatalog?   @relation(fields: [medicationCatalogId], references: [id])

  @@map("patient_allergies")
}

enum PatientMedicationStatus {
  ACTIVE
  SUSPENDED
  COMPLETED

  @@map("patient_medication_status")
}

// Conciliación de medicamentos habituales — vive en el paciente,
// arrastrado a cada consulta (M8-RN-012), usado para el chequeo de
// duplicidad terapéutica en M9-RN-008c.
model PatientMedication {
  id          String                  @id @default(uuid())
  patientId   String
  genericName String
  brandName   String?
  dose        String
  route       String
  frequency   String
  startedAt   DateTime?               @db.Date
  suspendedAt DateTime?               @db.Date
  reason      String?
  status      PatientMedicationStatus @default(ACTIVE)
  prescriber  String?
  source      String
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("patient_medications")
}

enum PatientHistoryCategory {
  HEREDOFAMILIAR
  PERSONAL_NO_PATOLOGICO
  PERSONAL_PATOLOGICO

  @@map("patient_history_category")
}

enum PatientHistoryStatus {
  PRESENTE
  NEGADO
  DESCONOCIDO
  NO_INVESTIGADO

  @@map("patient_history_status")
}

// M8-RN-012 / §10 de especificacion-plataforma-clinica-con-ia.md:
// antecedentes heredofamiliares/personales no patológicos/personales
// patológicos — viven en el paciente, se capturan una vez y se
// arrastran a cada consulta, igual que PatientAllergy/PatientMedication
// arriba. Modelo genérico (categoría+subtipo, no una columna por
// dato) porque así lo define el §24 del documento nuevo — subtipo es
// vocabulario fijo validado por Zod en los contratos, no en el schema.
// Alergias y medicamentos actuales NO se duplican aquí: ya viven en
// los dos modelos de arriba.
// P1 hallazgo #18 / Fase 1 Zona 1: el embarazo no existía en ninguna
// parte del repositorio. Estado del paciente (como alergias y
// medicamentos): UPDATE permitido, DELETE revocado por GRANT — lo que
// la regla "nada se borra" prohíbe es que la fila desaparezca.
// Máximo UN embarazo ACTIVE por paciente (índice único parcial en la
// migración — Prisma no modela índices parciales).
// FPP (eddDate): calculada en servidor como FUM+280 días salvo que se
// capture una FPP por ultrasonido; las SDG NUNCA se almacenan — se
// derivan de eddDate al leer (cálculo derivado siempre en servidor,
// mismo principio que IMC/escalas).
enum PregnancyStatus {
  ACTIVE
  CLOSED

  @@map("pregnancy_status")
}

enum PregnancyDatingMethod {
  FUM
  ULTRASONIDO

  @@map("pregnancy_dating_method")
}

model PatientPregnancy {
  id               String                @id @default(uuid())
  patientId        String
  status           PregnancyStatus       @default(ACTIVE)
  // FUM — puede faltar si la paciente no la recuerda y la datación
  // vino por ultrasonido.
  lmpDate          DateTime?             @db.Date
  // FPP — siempre presente: o FUM+280 (method=FUM) o la capturada por
  // ultrasonido (method=ULTRASONIDO).
  eddDate          DateTime              @db.Date
  eddMethod        PregnancyDatingMethod
  recordedByUserId String
  closedAt         DateTime?             @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, status])
  @@map("patient_pregnancies")
}

// EQUIVALENCIA FHIR (R7), declarada campo por campo (prompt 18):
//   category=HEREDOFAMILIAR        → FamilyMemberHistory
//     familyRelationship           → FamilyMemberHistory.relationship
//     status PRESENTE/NEGADO       → FamilyMemberHistory.condition /
//                                    absentReason (negation)
//   category=PERSONAL_*            → Condition (problema) u
//                                    Observation (hábito), según subtipo
//     subtype (término de catálogo)→ Condition.code / Observation.code
//     status                       → Condition.verificationStatus
//     freeText (comentario)        → .note
//     changeLog                    → provenance/versioning (Provenance)
//   inheritedFromTemplate          → SIN equivalente FHIR directo:
//     es control de calidad de captura (marca de copy-forward), se
//     documenta aquí como razón (R7 permite "razón documentada").
model PatientHistoryItem {
  id                       String                 @id @default(uuid())
  patientId                String
  category                 PatientHistoryCategory
  subtype                  String
  // Prompt 18: el subtipo queda REFERENCIADO al catálogo — el
  // servidor resuelve subtype→término ANTECEDENTE vigente y guarda su
  // id. Nullable solo por las filas previas a la Fase 2.
  catalogTermId            String?
  // Prompt 23B: "heredado de plantilla, sin revisar". La nota no se
  // puede firmar mientras exista un heredado sin revisar.
  inheritedFromTemplate    Boolean                @default(false)
  inheritedReviewedAt      DateTime?              @db.Timestamptz(3)
  // "NONE" (no null) para PERSONAL_NO_PATOLOGICO/PERSONAL_PATOLOGICO
  // — Postgres no compara NULL=NULL en el índice único de abajo, así
  // que un valor centinela no nulo es lo que hace que "una fila
  // vigente por (paciente, categoría, subtipo, familiar)" sea
  // realmente único también fuera de HEREDOFAMILIAR.
  familyRelationship       String                 @default("NONE")
  familyRelationshipDetail String?
  status                   PatientHistoryStatus   @default(NO_INVESTIGADO)
  structuredValue          Json?
  freeText                 String?
  updatedByUserId          String
  createdAt                DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(3)

  patient     Patient                    @relation(fields: [patientId], references: [id])
  catalogTerm ClinicalCatalogTerm?       @relation("HistoryItemTerm", fields: [catalogTermId], references: [id])
  changeLog   PatientHistoryItemChange[]

  @@unique([patientId, category, subtype, familyRelationship])
  @@map("patient_history_items")
}

// Append-only real vía GRANT (mismo tratamiento que
// PrescriptionCancellation/AppointmentStatusHistory): "toda
// modificación queda versionada" y "no borrar el valor histórico al
// actualizar" (§10.4 del documento nuevo). Cada UPDATE a
// PatientHistoryItem inserta aquí una foto del valor ANTERIOR antes
// de sobrescribir — nunca se actualiza ni se borra una fila de esta
// tabla.
// Prompt 21 — toxicomanías sobre el catálogo de sustancias.
// FHIR (R7): Observation con code=sustancia (SNOMED cuando se
// licencie), components cantidad/frecuencia; packYears →
// Observation 401201003-like (índice tabáquico); estados → status.
// Los índices se calculan y ALMACENAN en servidor con fórmula y
// versión — nunca viajan del cliente (regla de cálculos derivados).
enum SubstanceUseStatus {
  ACTIVO
  SUSPENDIDO
  NEGADO

  @@map("substance_use_status")
}

enum SubstanceUseUnit {
  CIGARROS_POR_DIA
  UNIDADES_POR_SEMANA
  UNIDADES_POR_DIA
  OTRA

  @@map("substance_use_unit")
}

model PatientSubstanceUse {
  id                 String              @id @default(uuid())
  patientId          String
  // FK real al catálogo SUSTANCIA_PSICOACTIVA (R2/R3).
  substanceTermId    String
  status             SubstanceUseStatus
  quantity           Decimal?            @db.Decimal(8, 2)
  unit               SubstanceUseUnit?
  ageOfOnset         Int?
  suspendedAt        DateTime?           @db.Date
  comment            String?
  // Calculados y almacenados con su fórmula y versión (prompt 21):
  // índice tabáquico (cigarros/día × años / 20) y unidades estándar
  // de alcohol por semana.
  packYears          Decimal?            @db.Decimal(8, 2)
  stdDrinksPerWeek   Decimal?            @db.Decimal(8, 2)
  computeFormula     String?
  computeVersion     String?
  updatedByUserId    String
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  patient       Patient                     @relation(fields: [patientId], references: [id])
  substanceTerm ClinicalCatalogTerm         @relation("SubstanceTerm", fields: [substanceTermId], references: [id])
  changeLog     PatientSubstanceUseChange[]

  @@unique([patientId, substanceTermId])
  @@map("patient_substance_uses")
}

// R1: cada actualización conserva el valor anterior con fecha y autor.
model PatientSubstanceUseChange {
  id               String   @id @default(uuid())
  substanceUseId   String
  previousValue    Json
  changedByUserId  String
  changedAt        DateTime @default(now()) @db.Timestamptz(3)

  substanceUse PatientSubstanceUse @relation(fields: [substanceUseId], references: [id])

  @@map("patient_substance_use_changes")
}

// Prompt 22 — bloque gineco-obstétrico. Se MUESTRA según el sexo
// registrado y puede habilitarse manualmente (manuallyEnabled) — el
// servidor lo oculta para sexAtBirth=M sin habilitación explícita.
// FHIR (R7): menarca/ciclo/actividad → Observations; fórmula
// obstétrica G/P/C/A → Observations 11996-6, 11977-6, 68499-3,
// 11612-9 (LOINC); antecedentes perinatales → .note (texto corto,
// razón documentada: narrativa perinatal sin catálogo estándar aún).
model PatientGynecoHistory {
  id                     String    @id @default(uuid())
  patientId              String    @unique
  manuallyEnabled        Boolean   @default(false)
  menarcheAge            Int?
  cycleDurationDays      Int?
  cycleFrequencyDays     Int?
  cycleAmount            String?
  dysmenorrhea           Boolean?
  otherDischarge         String?
  sexualOnsetAge         Int?
  sexualPartners         Int?
  contraceptiveMethod    String?
  sexualFrequency        String?
  stiHistory             String?
  gestas                 Int?
  partos                 Int?
  cesareas               Int?
  abortos                Int?
  perinatalHistory       String?
  updatedByUserId        String
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)

  patient   Patient                      @relation(fields: [patientId], references: [id])
  changeLog PatientGynecoHistoryChange[]

  @@map("patient_gyneco_histories")
}

model PatientGynecoHistoryChange {
  id              String   @id @default(uuid())
  gynecoHistoryId String
  previousValue   Json
  changedByUserId String
  changedAt       DateTime @default(now()) @db.Timestamptz(3)

  gynecoHistory PatientGynecoHistory @relation(fields: [gynecoHistoryId], references: [id])

  @@map("patient_gyneco_history_changes")
}

// Prompt 23B — plantillas de antecedentes por especialidad, propiedad
// del médico. Aplicarla marca cada dato como heredado; la firma se
// bloquea mientras haya heredados sin revisar.
model AntecedentesTemplate {
  id          String   @id @default(uuid())
  doctorId    String
  specialtyId String?
  name        String
  // Lista de {category, subtype, familyRelationship?, status, freeText?}
  // validada por contrato al crear; se aplica vía el MISMO upsert de
  // antecedentes (nunca un camino aparte que evada validaciones).
  items       Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  doctor    Doctor     @relation(fields: [doctorId], references: [id])
  specialty Specialty? @relation(fields: [specialtyId], references: [id])

  @@map("antecedentes_templates")
}

model PatientHistoryItemChange {
  id                      String                @id @default(uuid())
  historyItemId           String
  previousStatus          PatientHistoryStatus?
  previousStructuredValue Json?
  previousFreeText        String?
  changedByUserId         String
  changedAt               DateTime              @default(now()) @db.Timestamptz(3)

  historyItem PatientHistoryItem @relation(fields: [historyItemId], references: [id])

  @@map("patient_history_item_changes")
}

// Estándar público fijo (no es una regla clínica de negocio) —
// catálogo completo (~12,500 códigos vigentes) sembrado desde la
// fuente oficial DGIS/CEMECE (datos.gob.mx, CC-BY-4.0), ver
// prisma/data/cie10-dgis.json y seed.ts. Ampliar/actualizar el
// catálogo es reemplazar ese archivo con datos oficiales, nunca
// inventar contenido.
model Icd10Code {
  code        String  @id
  description String
  isActive    Boolean @default(true)

  encounterDiagnoses EncounterDiagnosis[]

  @@map("icd10_codes")
}

enum ControlGroup {
  I
  II
  III
  IV
  V
  VI

  @@map("control_group")
}

// M9-RN-012: Grupos I/II marcados isElectronicallyPrescribable=false;
// el bloqueo duro vive en PrescriptionsService, no aquí. Sembrado con
// un puñado de medicamentos sintéticos de ejemplo — ver el plan sobre
// no inventar contenido clínico real (dosis/contraindicaciones/grupo
// de control verdadero de cada fármaco).
// Prompt 33 — 🔒 PENDIENTE DE LICENCIA: la base comercial aún no se
// elige. El modelo de sincronización queda LISTO para cuando llegue:
// isActive=false retira un medicamento sin romper recetas históricas
// (la FK y los snapshots legales sobreviven; el buscador solo ofrece
// activos); sourceVersion registra de qué corte de la base vino cada
// fila; el grupo terapéutico es el prefijo ATC (4 caracteres), que el
// prompt 34 ya consume. Las 10 filas actuales son SINTÉTICAS de
// desarrollo — no prescribir con ellas en producción.
model MedicationCatalog {
  id                           String       @id @default(uuid())
  genericName                  String
  brandNames                   String[]     @default([])
  presentations                Json
  atcCode                      String?
  controlGroup                 ControlGroup
  isElectronicallyPrescribable Boolean      @default(true)
  commonDoses                  Json?
  contraindications            String[]     @default([])
  sourceVersion String?
  isActive                     Boolean      @default(true)
  createdAt                    DateTime     @default(now()) @db.Timestamptz(3)
  // Autoservicio: un médico agrega un medicamento que no encontró en
  // el catálogo directamente desde la receta, sin aprobación de admin
  // (decisión explícita del usuario, 2026-09-02) — controlGroup lo
  // declara el propio médico de forma obligatoria y explícita (nunca
  // texto libre ni default), así que R5 sigue aplicando exactamente
  // igual sobre esta fila que sobre cualquier otra. null = catálogo
  // sembrado/curado.
  addedByDoctorId              String?

  addedByDoctor     Doctor?             @relation(fields: [addedByDoctorId], references: [id])
  prescriptionItems PrescriptionItem[]

  patientAllergies PatientAllergy[]

  interactionsA MedicationInteraction[] @relation("InteractionA")
  interactionsB MedicationInteraction[] @relation("InteractionB")

  @@map("medications_catalog")
}

enum SpecialtyFieldSection {
  ANTECEDENTES
  INTERROGATORIO
  EXPLORACION
  ESCALAS
  SEGUIMIENTO

  @@map("specialty_field_section")
}

enum SpecialtyFieldInputType {
  NUMBER
  TEXT
  TEXTAREA
  SELECT
  MULTISELECT
  BOOLEAN
  DATE
  COMPUTED

  @@map("specialty_field_input_type")
}

// M8-RN-014: campos por especialidad como DATOS, no código. Solo el
// esquema base (medicina general, specialtyId=null) se publica en este
// pase — ginecología, pediatría y medicina interna requieren
// validación de un especialista de esa área (ver el plan), quedan sin
// filas hasta tener ese contenido.
model SpecialtyFieldSchema {
  id              String                  @id @default(uuid())
  specialtyId     String?
  version         Int
  section         SpecialtyFieldSection
  fieldKey        String
  label           String
  inputType       SpecialtyFieldInputType
  unit            String?
  minValue        Float?
  maxValue        Float?
  options         Json?
  isRequired      Boolean                 @default(false)
  displayOrder    Int                     @default(0)
  helpText        String?
  computedFormula String?
  publishedAt     DateTime?               @db.Timestamptz(3)
  publishedBy     String?
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)

  specialty Specialty? @relation(fields: [specialtyId], references: [id])

  @@map("specialty_field_schemas")
}

// Validado contra el esquema al firmar; la versión queda fija — si
// cambia una guía, las notas viejas conservan su cálculo (M8-RN-014).
model EncounterSpecialtyData {
  id                     String   @id @default(uuid())
  encounterId            String   @unique
  specialtySchemaVersion Int
  data                   Json
  createdAt              DateTime @default(now()) @db.Timestamptz(3)

  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id])

  @@map("encounter_specialty_data")
}

// Fase 7 · Prompt 47 — modelo genérico de protocolo longitudinal
// (generalización del módulo de quimioterapia del sistema de
// referencia): línea de tratamiento → esquema → ciclo → día del
// ciclo, aquí como protocolo → instancia por paciente → sesión.
//
// Definición como DATOS, no código (mismo patrón que
// SpecialtyFieldSchema/EncounterSpecialtyData ya usa para "qué
// capturar" por especialidad) — un protocolo nuevo se siembra, nunca
// se programa. sourceCitation es obligatorio EN LA PRÁCTICA para
// cualquier protocolo que se presente como clínicamente vigente
// (control prenatal, vacunación); solo el protocolo de demostración
// sembrado para probar el motor lo deja vacío, marcado como tal.
model TreatmentProtocol {
  id             String   @id @default(uuid())
  name           String
  specialtyId    String?
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  sourceCitation String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  specialty     Specialty?                        @relation(fields: [specialtyId], references: [id])
  sessionTemplates TreatmentProtocolSessionTemplate[]
  fieldSchemas  ProtocolFieldSchema[]
  instances     PatientProtocolInstance[]

  @@map("treatment_protocols")
}

// Sesiones esperadas + su ventana de tiempo (prompt 47A). Los
// offsets son relativos a PatientProtocolInstance.startedAt — ver la
// nota de diseño en el plan de Fase 7 sobre por qué no se ancla a
// fecha de última menstruación aquí (eso le corresponde al calendario
// prenatal real, todavía pendiente).
model TreatmentProtocolSessionTemplate {
  id                    String @id @default(uuid())
  protocolId            String
  sequenceNumber        Int
  label                 String
  windowStartOffsetDays Int
  windowEndOffsetDays   Int

  protocol TreatmentProtocol @relation(fields: [protocolId], references: [id])
  sessions ProtocolSession[]

  @@unique([protocolId, sequenceNumber])
  @@map("treatment_protocol_session_templates")
}

// "Datos a capturar por sesión" (prompt 47A) — mirror literal de
// SpecialtyFieldSchema, mismo enum SpecialtyFieldInputType (no se
// inventa un segundo vocabulario de tipos de campo).
model ProtocolFieldSchema {
  id           String                  @id @default(uuid())
  protocolId   String
  version      Int                     @default(1)
  fieldKey     String
  label        String
  inputType    SpecialtyFieldInputType
  unit         String?
  minValue     Float?
  maxValue     Float?
  options      Json?
  isRequired   Boolean                 @default(false)
  displayOrder Int                     @default(0)
  helpText     String?

  protocol TreatmentProtocol @relation(fields: [protocolId], references: [id])

  @@map("protocol_field_schemas")
}

enum PatientProtocolInstanceStatus {
  ACTIVE
  CLOSED

  @@map("patient_protocol_instance_status")
}

// Motivo de cierre — texto LITERAL del prompt 47 ("completado,
// abandonado, cambio de plan, referido"), no inventado.
enum ProtocolInstanceClosureReason {
  COMPLETADO
  ABANDONADO
  CAMBIO_PLAN
  REFERIDO

  @@map("protocol_instance_closure_reason")
}

// Instancia por paciente (prompt 47B). protocolVersion es un
// snapshot al iniciar — igual que EncounterSpecialtyData.
// specialtySchemaVersion, para que editar el protocolo después no
// cambie retroactivamente instancias en curso.
model PatientProtocolInstance {
  id                   String                         @id @default(uuid())
  patientId            String
  protocolId           String
  protocolVersion      Int
  status               PatientProtocolInstanceStatus @default(ACTIVE)
  startedAt            DateTime                       @default(now()) @db.Timestamptz(3)
  startedByUserId      String
  currentSessionNumber Int                            @default(1)
  closedAt             DateTime?                      @db.Timestamptz(3)
  closureReason        ProtocolInstanceClosureReason?
  closureNotes         String?

  patient  Patient           @relation(fields: [patientId], references: [id])
  protocol TreatmentProtocol @relation(fields: [protocolId], references: [id])
  sessions ProtocolSession[]

  @@index([patientId, status])
  @@map("patient_protocol_instances")
}

// Sesión real (prompt 47C). Se genera UNA fila por cada
// TreatmentProtocolSessionTemplate al abrir la instancia — proposedDate
// ya calculada, actualDate null hasta que ocurre. "Una sesión fuera
// de ventana se REGISTRA como tal, no se rechaza" (regla explícita
// del prompt): withinWindow solo se calcula, nunca bloquea.
model ProtocolSession {
  id             String    @id @default(uuid())
  instanceId     String
  templateId     String
  sequenceNumber Int
  proposedDate   DateTime  @db.Date
  actualDate     DateTime? @db.Date
  withinWindow   Boolean?
  encounterId    String?
  data           Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  instance  PatientProtocolInstance           @relation(fields: [instanceId], references: [id])
  template  TreatmentProtocolSessionTemplate  @relation(fields: [templateId], references: [id])
  encounter ClinicalEncounter?                @relation(fields: [encounterId], references: [id])

  @@unique([instanceId, sequenceNumber])
  @@map("protocol_sessions")
}

enum PrescriptionType {
  ELECTRONIC
  EXTERNAL_PHYSICAL

  @@map("prescription_type")
}

// Corrección v2.1 de especificacion-plataforma-clinica-con-ia.md §1:
// "la firma digital no debe ser obligatoria para imprimir una
// receta". Elección de primer nivel del médico para
// prescriptionType=ELECTRONIC (null para EXTERNAL_PHYSICAL, donde
// ninguna de las dos rutas aplica). Corresponde a
// autografa_post_impresion / digital_electronica del §24 del
// documento.
enum PrescriptionSignatureRoute {
  HANDWRITTEN_AFTER_PRINT
  ELECTRONIC

  @@map("prescription_signature_route")
}

// M9 §6.6: folio único vía secuencia Postgres dedicada (mismo patrón
// que patients_medicfy_id_seq — ver migración). Snapshots legales
// inmutables (M9-RN-004): nunca resueltos por join al imprimir.
//
// R1 nombra "prescriptions" literalmente como append-only — a
// diferencia de `appointments` (cuyo status sí se actualiza in-place
// porque esa tabla no está en la lista de R1), esta fila NUNCA se
// actualiza después de crearse, ni siquiera para marcarla cancelada.
// "Cancelar" = insertar una fila en PrescriptionCancellation
// (M9-RN-006); el estado "cancelada" se deriva de si existe esa fila,
// nunca de un UPDATE aquí. "Reemitir" = nueva Prescription con
// replacesPrescriptionId apuntando hacia atrás, fijado al crearse — no
// requiere tocar la fila original en absoluto.
model Prescription {
  id                        String                      @id @default(uuid())
  encounterId               String
  patientId                 String
  doctorId                  String
  folio                     String                      @unique
  prescriptionType          PrescriptionType            @default(ELECTRONIC)
  issuedAt                  DateTime                    @default(now()) @db.Timestamptz(3)
  doctorNameSnapshot        String
  doctorLicenseSnapshot     String
  doctorSpecialtySnapshot   String?
  doctorInstitutionSnapshot String?
  practiceAddressSnapshot   String
  patientNameSnapshot       String
  patientAgeSnapshot        Int
  patientSexSnapshot        String
  diagnosisSnapshot         String
  generalInstructions       String?
  replacesPrescriptionId    String?                     @unique
  // NULL para prescriptionType=EXTERNAL_PHYSICAL (M9-RN-014): "sin
  // PDF, sin QR, sin pretensión de validez electrónica" — Medicfy no
  // firma nada, solo registra lo que el médico ya emitió en su
  // recetario físico. physicalRecipeFolio guarda ESE folio (distinto
  // de `folio`, que siempre es el interno de Medicfy).
  physicalRecipeFolio       String?
  // Requerido para prescriptionType=ELECTRONIC, null para
  // EXTERNAL_PHYSICAL. Cuando es HANDWRITTEN_AFTER_PRINT,
  // signatureMethod/signatureTimestamp se quedan null a propósito —
  // no hubo mecanismo digital que registrar (ver comentario del
  // enum). contentHashSha256/qrVerificationToken SÍ se calculan
  // siempre, en ambas rutas: la huella documental es sobre el
  // contenido, no sobre el mecanismo de firma.
  signatureRoute            PrescriptionSignatureRoute?
  signatureMethod           SignatureMethod?
  signatureTimestamp        DateTime?                   @db.Timestamptz(3)
  contentHashSha256         String?
  pdfFileKey                String?
  qrVerificationToken       String?                     @unique
  deliveredVia              String[]                    @default([])
  deliveredAt               DateTime?                   @db.Timestamptz(3)
  createdAt                 DateTime                    @default(now()) @db.Timestamptz(3)

  encounter              ClinicalEncounter                @relation(fields: [encounterId], references: [id])
  patient                Patient                          @relation(fields: [patientId], references: [id])
  doctor                 Doctor                           @relation(fields: [doctorId], references: [id])
  replacesPrescription   Prescription?                    @relation("PrescriptionReplacement", fields: [replacesPrescriptionId], references: [id])
  replacedByPrescription Prescription?                    @relation("PrescriptionReplacement")
  // Prompt 34: el bloqueo por alergia SOLO se libera con una
  // justificación clínica que queda registrada en el expediente y
  // firmada por el médico (viaja dentro del snapshot legal firmado).
  allergyOverrideJustification String?
  items                  PrescriptionItem[]
  cancellation           PrescriptionCancellation?
  handwrittenDelivery    PrescriptionHandwrittenDelivery?

  @@map("prescriptions")
}

// Fila única por receta (prescriptionId @unique — no se puede cancelar
// dos veces), solo INSERT+SELECT para medicfy_app, igual que
// clinical_notes. Es la única forma real de "cancelar" (M9-RN-006).
model PrescriptionCancellation {
  id                String   @id @default(uuid())
  prescriptionId    String   @unique
  reason            String
  cancelledByUserId String
  cancelledAt       DateTime @default(now()) @db.Timestamptz(3)

  prescription Prescription @relation(fields: [prescriptionId], references: [id])

  @@map("prescription_cancellations")
}

// Solo aplica a signatureRoute=HANDWRITTEN_AFTER_PRINT. Misma razón
// que PrescriptionCancellation: R1 prohíbe UPDATE sobre
// prescriptions, así que "Firmada y entregada" (§17.4 del documento)
// no puede escribirse encima de la fila original — su sola
// existencia ES el estado "confirmada", nunca un UPDATE. Es una
// declaración manual del médico (§17.4: "sin afirmar que el sistema
// verificó físicamente la firma"), no una firma criptográfica.
model PrescriptionHandwrittenDelivery {
  id                String   @id @default(uuid())
  prescriptionId    String   @unique
  confirmedByUserId String
  confirmedAt       DateTime @default(now()) @db.Timestamptz(3)

  prescription Prescription @relation(fields: [prescriptionId], references: [id])

  @@map("prescription_handwritten_deliveries")
}

// M9-RN-003: denominación genérica obligatoria por ley; comercial
// opcional. controlGroup se copia del catálogo al prescribir (mismo
// principio de snapshot que los datos legales del médico).
model PrescriptionItem {
  id                  String       @id @default(uuid())
  prescriptionId      String
  genericName         String
  brandName           String?
  presentation        String
  dose                String
  route               String
  frequency           String
  // Prompt 32: unidad de dosis explícita e indicación por línea.
  doseUnit             String?
  indication           String?
  // Prompt 36 — procedencia: NUEVA | HEREDADA | HEREDADA_MODIFICADA,
  // con la receta y fecha de origen cuando viene de "traer última".
  origin               String    @default("NUEVA")
  sourcePrescriptionId String?
  sourceIssuedAt       DateTime? @db.Timestamptz(3)
  duration            String
  quantity            String?
  specialInstructions String?
  medicationCatalogId String?
  controlGroup        ControlGroup

  prescription      Prescription       @relation(fields: [prescriptionId], references: [id])
  medicationCatalog MedicationCatalog? @relation(fields: [medicationCatalogId], references: [id])

  @@map("prescription_items")
}

// M10 (parcial en MVP, spec §2.2): PDF firmado, sin portal de
// laboratorio ni assignedLabId activo — el paciente lo lleva a
// cualquier laboratorio.
//
// R1 nombra "lab_orders" literalmente como append-only, mismo
// tratamiento que prescriptions: esta fila nunca se actualiza después
// de insertarse. "Estado" se deriva, no se guarda: issued por
// defecto, results_uploaded si existe una fila en LabResult para esta
// orden, cancelled si existe una fila en LabOrderCancellation.
enum LabOrderSignatureRoute {
  HANDWRITTEN_AFTER_PRINT
  ELECTRONIC

  @@map("lab_order_signature_route")
}

// A petición explícita del usuario (2026-08-24): M10 nunca exigió
// contraseña+TOTP para órdenes de laboratorio (a diferencia de
// M9-RN-009 para recetas) — ese requisito se había copiado del
// patrón de recetas sin que la especificación lo pidiera. Mismas dos
// rutas que Prescription: signatureMethod/signedAt quedan null en
// HANDWRITTEN_AFTER_PRINT (no hubo mecanismo digital que registrar).
// Snapshots nullable (a diferencia de Prescription) porque esta
// tabla ya tenía filas de prueba antes de agregar estas columnas —
// la aplicación siempre las llena en create(), nunca quedan null
// para una orden nueva.
model LabOrder {
  id                        String                  @id @default(uuid())
  encounterId               String
  patientId                 String
  doctorId                  String
  folio                     String                  @unique
  issuedAt                  DateTime                @default(now()) @db.Timestamptz(3)
  clinicalIndication        String
  fastingRequired           Boolean                 @default(false)
  assignedLabId             String?
  doctorNameSnapshot        String?
  doctorLicenseSnapshot     String?
  doctorSpecialtySnapshot   String?
  doctorInstitutionSnapshot String?
  practiceAddressSnapshot   String?
  patientNameSnapshot       String?
  patientAgeSnapshot        Int?
  patientSexSnapshot        String?
  signatureRoute            LabOrderSignatureRoute?
  pdfFileKey                String?
  qrVerificationToken       String                  @unique
  contentHashSha256         String
  signatureMethod           SignatureMethod?
  signedAt                  DateTime?               @db.Timestamptz(3)
  createdAt                 DateTime                @default(now()) @db.Timestamptz(3)

  encounter    ClinicalEncounter     @relation(fields: [encounterId], references: [id])
  patient      Patient               @relation(fields: [patientId], references: [id])
  doctor       Doctor                @relation(fields: [doctorId], references: [id])
  items          LabOrderItem[]
  results        LabResult[]
  resultAnalytes LabResultAnalyte[]
  cancellation   LabOrderCancellation?

  @@map("lab_orders")
}

// Mismo patrón que PrescriptionCancellation: única fila por orden
// (labOrderId @unique), solo INSERT+SELECT, es la única forma real de
// cancelar una orden de laboratorio.
model LabOrderCancellation {
  id                String   @id @default(uuid())
  labOrderId        String   @unique
  reason            String
  cancelledByUserId String
  cancelledAt       DateTime @default(now()) @db.Timestamptz(3)

  labOrder LabOrder @relation(fields: [labOrderId], references: [id])

  @@map("lab_order_cancellations")
}

// Prompt 35 — interacciones fármaco-fármaco. El MOTOR está completo;
// los DATOS de producción llegan con la base licenciada (decisión 🔒
// del prompt 33, PENDIENTE). Las filas sembradas son un set de
// demostración de pares clásicos verificables (fuente citada en
// seed.ts), marcadas pendingMedicalReview — NO son la base clínica.
// GRAVE → advertencia con confirmación explícita obligatoria;
// MODERADA → informa sin bloquear. Todo queda en bitácora.
model MedicationInteraction {
  id                   String  @id @default(uuid())
  medicationAId        String
  medicationBId        String
  severity             String
  description          String
  source               String
  pendingMedicalReview Boolean @default(true)

  medicationA MedicationCatalog @relation("InteractionA", fields: [medicationAId], references: [id])
  medicationB MedicationCatalog @relation("InteractionB", fields: [medicationBId], references: [id])

  @@unique([medicationAId, medicationBId])
  @@map("medication_interactions")
}

// Prompt 37A — el estudio viene del catálogo en DOS niveles (el tipo
// filtra los estudios concretos; el vínculo estudio→tipo viaja en
// externalCode del término, documentado en seed.ts) y el MOTIVO es
// OBLIGATORIO y de catálogo cerrado. studyName queda como snapshot
// legible (entra al PDF y al hash) resuelto SIEMPRE del término.
model LabOrderItem {
  id           String  @id @default(uuid())
  labOrderId   String
  studyName    String
  loincCode    String?
  studyTermId  String?
  motiveTermId String?
  notes        String?

  labOrder   LabOrder             @relation(fields: [labOrderId], references: [id])
  studyTerm  ClinicalCatalogTerm? @relation("LabStudyTerm", fields: [studyTermId], references: [id])
  motiveTerm ClinicalCatalogTerm? @relation("LabMotiveTerm", fields: [motiveTermId], references: [id])

  @@map("lab_order_items")
}

enum LabResultUploaderRole {
  DOCTOR
  PATIENT

  @@map("lab_result_uploader_role")
}

// v1.0: sube el médico o el paciente (§6.7).
model LabResult {
  id                 String                @id @default(uuid())
  labOrderId         String?
  patientId          String
  uploadedByUserId   String
  uploadedByRole     LabResultUploaderRole
  fileKey            String
  fileHashSha256     String
  labName            String?
  resultDate         DateTime?             @db.Date
  reviewedByDoctorId String?
  reviewedAt         DateTime?             @db.Timestamptz(3)
  doctorComment      String?
  uploadedAt         DateTime              @default(now()) @db.Timestamptz(3)

  labOrder LabOrder? @relation(fields: [labOrderId], references: [id])
  patient  Patient   @relation(fields: [patientId], references: [id])

  @@map("lab_results")
}

// Fase 5 · Prompt 42A: "Resultados de laboratorio como analitos
// ESTRUCTURADOS ... NO como un PDF adjunto ni como número de orden."
// Complementa LabResult (el archivo crudo) sin reemplazarlo — el
// médico transcribe el valor a mano (sin OCR/parseo automático, fuera
// de alcance). loincCode opcional: M10-RN-005 no exige un catálogo
// LOINC completo. reviewedAt/reviewedByDoctorId se actualizan con
// UPDATE (mismo patrón ya establecido en LabResult.reviewedAt) — no
// está en la lista literal de R1.
model LabResultAnalyte {
  id                 String    @id @default(uuid())
  patientId          String
  labOrderId         String?
  analyteName        String
  loincCode          String?
  value              Decimal   @db.Decimal(10, 3)
  unit               String
  referenceMin       Decimal?  @db.Decimal(10, 3)
  referenceMax       Decimal?  @db.Decimal(10, 3)
  measuredAt         DateTime  @db.Timestamptz(3)
  // v2.5: laboratorio de origen si se conoce (detectado en la hoja o
  // escrito por el médico al revisar una extracción) — nunca lo tenía
  // esta tabla, a diferencia de LabResult (el archivo crudo).
  labName            String?
  enteredByUserId    String
  reviewedByDoctorId String?
  reviewedAt         DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  labOrder LabOrder? @relation(fields: [labOrderId], references: [id])
  patient  Patient   @relation(fields: [patientId], references: [id])
  noteReferences NoteLabResult[]

  // v2.5: si el analito llegó por lectura automática ya revisada por
  // el médico, la nota/PDF puede mostrar el aviso de validación
  // correspondiente sin adivinar la procedencia. MANUAL es el default
  // — cubre toda captura anterior a esta versión sin migrar datos.
  source LabResultAnalyteSource @default(MANUAL)

  @@index([patientId, analyteName])
  @@map("lab_result_analytes")
}

enum LabResultAnalyteSource {
  MANUAL
  OCR_REVIEWED

  @@map("lab_result_analyte_source")
}

// v2.5 — Capa 1 (extracción). "Ningún valor extraído se escribe en la
// nota sin que el médico lo revise" (pedido explícito del usuario,
// 2026-09-02): por eso esto vive en una tabla de espera separada de
// LabResultAnalyte, nunca la toca hasta submitReview() promueve cada
// candidata confirmada. status EXTRACTING es casi siempre transitorio
// dentro de una misma petición (Capa 1 es síncrona, sin cola) — solo
// sobrevive si el proceso murió a medio camino, y retry() lo retoma.
enum LabSheetExtractionStatus {
  UPLOADING
  EXTRACTING
  REVIEW_PENDING
  ACCEPTED
  FAILED

  @@map("lab_sheet_extraction_status")
}

model LabSheetExtraction {
  id                  String                   @id @default(uuid())
  patientId           String
  uploadedByUserId    String
  fileKey             String
  fileHashSha256      String
  status              LabSheetExtractionStatus @default(EXTRACTING)
  labNameDetected     String?
  resultDateDetected  DateTime?                @db.Date
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  reviewedAt          DateTime?                @db.Timestamptz(3)
  reviewedByUserId    String?

  patient    Patient                     @relation(fields: [patientId], references: [id])
  candidates LabSheetExtractionCandidate[]

  @@index([patientId, createdAt])
  @@map("lab_sheet_extractions")
}

enum LabSheetExtractionConfidence {
  LOW
  MEDIUM
  HIGH

  @@map("lab_sheet_extraction_confidence")
}

// Una fila por analito candidato dentro de una hoja. Los campos "Raw"
// son lo que devolvió Textract sin tocar; los "doctorConfirmed*" solo
// se llenan si el médico corrigió el valor durante la revisión —
// wasEdited es la señal de auditoría de si hubo corrección, sin
// tener que diffar texto. La regla de oro (M10-RN-007): una candidata
// LOW sin wasEdited=true exige su propia confirmación explícita
// aparte (ver LabSheetExtractionService.submitReview) antes de poder
// promoverse — included por sí solo no basta.
model LabSheetExtractionCandidate {
  id                         String                        @id @default(uuid())
  extractionId               String
  analyteNameRaw             String
  valueRaw                   String
  unitRaw                    String?
  referenceMinPrinted        Decimal?                      @db.Decimal(10, 3)
  referenceMaxPrinted        Decimal?                      @db.Decimal(10, 3)
  confidence                 LabSheetExtractionConfidence
  doctorConfirmedAnalyteName String?
  doctorConfirmedValue       Decimal?                      @db.Decimal(10, 3)
  doctorConfirmedUnit        String?
  wasEdited                  Boolean                       @default(false)
  included                   Boolean                       @default(true)

  extraction LabSheetExtraction @relation(fields: [extractionId], references: [id])

  @@index([extractionId])
  @@map("lab_sheet_extraction_candidates")
}

// v2.5 — Capa 2 (marcado determinista). Sin precedente en ninguna
// versión anterior de la especificación — se documenta y autoriza por
// primera vez en v2.5 (M10-RN-008/009), con pendingMedicalReview como
// condición de aprobación. Mismo patrón exacto que
// MedicationInteraction (pendingMedicalReview + source citada): las
// filas sembradas son un punto de partida citado, NO la base clínica
// final de la plataforma, hasta que un CURATOR/SUPERADMIN las aprueba.
model LabReferenceRange {
  id                   String    @id @default(uuid())
  // normalizeTerm(analyteLabel) — mismo normalizador que catálogos,
  // así "Glucosa"/"GLUCOSA"/"glucosa." casan con la misma fila.
  analyteKey           String
  analyteLabel         String
  unit                 String
  sex                  LabReferenceRangeSex
  ageMinYears          Decimal   @db.Decimal(5, 2)
  ageMaxYears          Decimal   @db.Decimal(5, 2)
  valueMin             Decimal   @db.Decimal(10, 3)
  valueMax             Decimal   @db.Decimal(10, 3)
  criticalMin          Decimal?  @db.Decimal(10, 3)
  criticalMax          Decimal?  @db.Decimal(10, 3)
  pendingMedicalReview Boolean   @default(true)
  curatedBy            String?
  source               String
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  curator User? @relation("LabReferenceRangeCurator", fields: [curatedBy], references: [id])

  @@index([analyteKey, sex, ageMinYears, ageMaxYears])
  @@map("lab_reference_ranges")
}

enum LabReferenceRangeSex {
  M
  F
  ANY

  @@map("lab_reference_range_sex")
}

// Prompt 7 (medicfy-50-prompts.md), R2 "los catálogos son cerrados".
// Infraestructura nueva y paralela a Specialty/Icd10Code/MedicationCatalog
// — no los reemplaza ni los migra (fuera de alcance de este prompt).
// Un término nunca se borra: se marca OBSOLETE o se fusiona
// (status=MERGED + mergedIntoId apuntando al vigente). Los registros
// que ya referencian un término fusionado por su id lo siguen
// resolviendo sin error — la fila nunca desaparece; solo una consulta
// NUEVA que pida "el vigente" necesita caminar mergedIntoId
// (ClinicalCatalogService.resolveCurrent).
// Prompt 10: el flujo "solicitar término nuevo" — el médico pide desde
// la captura, el curador aprueba/rechaza/fusiona desde su bandeja. La
// captura NUNCA inserta en el catálogo (R2 imposible por diseño): lo
// único que un médico puede crear es esta solicitud.
enum CatalogTermRequestStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED

  @@map("catalog_term_request_status")
}

model CatalogTermRequest {
  id              String                   @id @default(uuid())
  domain          String
  proposedTerm    String
  justification   String?
  status          CatalogTermRequestStatus @default(PENDING)
  requestedBy     String
  resolvedBy      String?
  // Al aprobar: el término creado. Al fusionar: el término existente
  // al que el curador mapeó la solicitud.
  resultingTermId String?
  resolutionNote  String?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  resolvedAt      DateTime?                @db.Timestamptz(3)

  requester User                 @relation("TermRequestRequester", fields: [requestedBy], references: [id])
  resulting ClinicalCatalogTerm? @relation(fields: [resultingTermId], references: [id])

  @@index([status, domain])
  @@map("catalog_term_requests")
}

enum ClinicalCatalogTermStatus {
  ACTIVE
  OBSOLETE
  MERGED

  @@map("clinical_catalog_term_status")
}

model ClinicalCatalogTerm {
  id            String                    @id @default(uuid())
  // Discriminador del catálogo (ej. "ALERGIA_AGENTE") — String en la
  // base para no exigir una migración por dominio nuevo, pero CERRADO
  // en el contrato: CATALOG_DOMAINS (catalog.schema.ts) es un z.enum
  // y la API rechaza cualquier dominio fuera de esa lista (Prompt 9).
  domain        String
  key           String
  preferredTerm String
  // Prompt 8: minúsculas/sin acentos/sin puntuación final/espacios
  // colapsados (term-normalizer.util.ts) — calculado en servidor al
  // crear, nunca recibido del cliente. Único junto con domain,
  // SIN filtrar por status: un término ya obsoleto o fusionado sigue
  // bloqueando que alguien recree el mismo duplicado.
  normalizedTerm String
  synonyms      String[]                  @default([])
  externalCode  String?
  // Nunca null — R2: "todo catálogo declara su sistema de
  // codificación externo o queda documentado explícitamente como
  // propietario" (valor "PROPIETARIO", no un campo vacío).
  codingSystem  String
  version       Int                       @default(1)
  status        ClinicalCatalogTermStatus @default(ACTIVE)
  mergedIntoId  String?
  // Prompt 9: "marca los términos que necesitan validación de un
  // médico antes de darse por buenos" — los sembrados de listas
  // estándar no revisadas por Jorge nacen con true.
  pendingMedicalReview Boolean @default(false)
  // Prompt 10: FK real al usuario curador que dio de alta el término.
  // El servidor la fija con el actor autenticado — nunca viaja del
  // cliente. Nullable sólo por los términos sembrados por seed.
  curatedBy     String?
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)

  mergedInto ClinicalCatalogTerm?  @relation("CatalogTermMerge", fields: [mergedIntoId], references: [id])
  mergedFrom ClinicalCatalogTerm[] @relation("CatalogTermMerge")
  curator    User?                 @relation("CatalogTermCurator", fields: [curatedBy], references: [id])
  requests   CatalogTermRequest[]
  historyItems PatientHistoryItem[] @relation("HistoryItemTerm")
  allergyTerms  PatientAllergy[]      @relation("AllergyTerm")
  substanceUses PatientSubstanceUse[] @relation("SubstanceTerm")
  notesTyped    ClinicalNote[]        @relation("NoteTypeTerm")
  labStudyItems  LabOrderItem[]       @relation("LabStudyTerm")
  labMotiveItems LabOrderItem[]       @relation("LabMotiveTerm")
  noteCancellationReasons ClinicalNoteCancellation[] @relation("NoteCancellationReasonTerm")

  @@unique([domain, key])
  @@unique([domain, normalizedTerm])
  @@map("clinical_catalog_terms")
}

// Fase 8 · Prompt 51 (docs/medicfy-58-prompts.md, Bloque 9). Slice
// mínimo de persistencia para que "los pases anteriores se conservan"
// (Prompt 51) y el tope de gasto por consulta (que necesita sumar
// tokens entre llamadas HTTP separadas) tengan dónde vivir. El
// Prompt 56 ("Datos, métricas y pruebas de la Fase 8") es quien
// diseña el modelo completo (SugerenciaAsistente/PreguntaAsistente/
// AcuseBanderaRoja/VersionPrompt) — esta tabla es deliberadamente
// angosta, para no adelantar esa decisión.
//
// Append-only, mismo criterio que clinical_notes (R1): una lectura es
// lo que el modelo le dijo al médico en un momento dado — igual que
// una nota firmada, corregirla es escribir una fila nueva (un pase
// nuevo), nunca reescribir la vieja.
model AssistantReading {
  id                String        @id @default(uuid())
  encounterId       String
  pase              AssistantPass
  contextHashSha256 String
  readingJson       Json
  modelVersion      String
  promptVersion     String
  inputTokens       Int
  outputTokens      Int
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)

  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id])

  @@index([encounterId, createdAt])
  @@map("assistant_readings")
}

enum AssistantPass {
  SUBJETIVO
  OBJETIVO
  ANALISIS
  CIERRE

  @@map("assistant_pass")
}

// Fase 8 · Prompt 52 — filtro de seguridad determinista, INDEPENDIENTE
// del modelo de IA (banderas-rojas-medicfy.md, documento del médico
// responsable, 2026-09-02). "Es la red de seguridad por si el modelo
// minimiza o pasa por alto un hallazgo grave": corre sobre datos
// estructurados (signos vitales, síntomas de catálogo cerrado), nunca
// sobre texto libre ni sobre la salida del asistente.
//
// Append-only, mismo criterio que assistant_readings/clinical_notes
// (R1): una bandera es un evento clínico que ocurrió en un momento
// dado — nunca se reescribe. @@unique([encounterId, flagCode]) es el
// mecanismo de dedup: el autoguardado corre cada 10s y no debe crear
// una fila nueva cada vez que la misma condición sigue vigente.
model RedFlagEvent {
  id              String   @id @default(uuid())
  encounterId     String
  flagCode        String
  // Mismo vocabulario que AssistantReading.banderas_rojas.urgencia
  // (Prompt 49): "inmediata" | "misma_consulta" | "seguimiento".
  urgency         String
  detectionMethod String
  finding         String
  // El valor concreto que disparó la bandera (p.ej. {"spo2": 85}) —
  // dato clínico legítimo en una tabla de expediente protegida por
  // CareRelationshipGuard, no un log externo (R2 prohíbe esto en
  // canales externos/logs de aplicación, no en el propio expediente).
  triggerData     Json
  detectedAt      DateTime @default(now()) @db.Timestamptz(3)

  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id])

  @@unique([encounterId, flagCode])
  @@index([encounterId, detectedAt])
  @@map("red_flag_events")
}
