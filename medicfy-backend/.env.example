# Copy to .env and fill in. Never commit the real .env file.
# Local development only — staging and production use synthetic data
# exclusively per CLAUDE.md R7.

NODE_ENV=development

# apps/api
PORT=3001

# Used by `prisma migrate` / `prisma generate` only. Connects with
# schema-owner privileges (CREATE TABLE, CREATE ROLE, GRANT). Never used
# by the running application.
DATABASE_URL=postgresql://jorgetinoco@localhost:5432/medicfy_mvp_dev?schema=public
SHADOW_DATABASE_URL=postgresql://jorgetinoco@localhost:5432/medicfy_mvp_shadow?schema=public

# Used by the NestJS app at runtime. Connects as medicfy_app, a role
# with only the privileges each migration explicitly GRANTs it — e.g.
# SELECT + INSERT on clinical_notes, never UPDATE/DELETE (R1,
# M15-RN-001). This is the connection that must never be the schema
# owner.
APP_DATABASE_URL=postgresql://medicfy_app@localhost:5432/medicfy_mvp_dev?schema=public

# Generate locally, never commit real values:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-byte-random-hex-string
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_SECRET_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
APP_BASE_URL=http://localhost:3001

# apps/web's own origin, for CORS (Sprint 5c). Credentialed
# cross-origin requests (the httpOnly refresh cookie) require an
# explicit origin, never "*".
WEB_ORIGIN=http://localhost:3000

# Auditoría 2026-10-21 (A-16): número de proxies inversos delante del
# API. En producción, detrás de nginx, es 1 (es el valor por omisión
# cuando NODE_ENV=production). Sin esto, audit_log registra la IP del
# proxy en vez de la del usuario (R3). Nunca pongas un valor mayor al
# número real de saltos: permitiría falsificar la IP con
# X-Forwarded-For.
# TRUST_PROXY_HOPS=1

# A-18: Swagger (/api/docs) solo se publica fuera de producción. Para
# publicarlo en producción hay que activarlo explícitamente.
# ENABLE_API_DOCS=false

# Fase 8 · Prompt 51 ("El Segundo Lector"). Optional — the app runs
# fine without it, only the assistant module degrades to "unavailable".
# Get a real key from https://console.anthropic.com and set it ONLY in
# your local .env, never commit it. Restart the dev server after
# setting it (env vars aren't picked up by --watch's hot reload).
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_MODEL_ID=claude-sonnet-5
# ASSISTANT_MODEL_TIMEOUT_MS=180000
# ASSISTANT_MAX_TOKENS_PER_ENCOUNTER=60000

# M12: recordatorios de cita 24h/2h antes (Redis+BullMQ, decisión
# explícita del usuario, 2026-09-08). Optional — el resto de la app
# (agendar/confirmar/cancelar/reagendar citas) funciona con
# normalidad sin esto, solo el encolado de recordatorios se degrada a
# "no disponible" (AppointmentReminderSchedulerService lo registra en
# log, nunca tumba una operación de agenda).
# REDIS_URL=redis://localhost:6379

# Atlas Anatómico 3D (~/Desktop/3d-Anatamics, docs/INTEGRATION_GUIDE.md).
# Optional — sin estas variables el expediente funciona igual, solo la
# ventana del atlas se degrada a "no disponible". El secreto es el del
# cliente de integración que muestra el seed del atlas; nunca lo
# subas al repo ni lo mandes al navegador.
# ATLAS_API_URL=http://localhost:4000
# ATLAS_VIEWER_URL=http://localhost:3300
# ATLAS_CLIENT_ID=demo-host
# ATLAS_CLIENT_SECRET=

# M7 (Teleconsulta, MVP) — Daily.co. Optional — sin esta variable la
# cita funciona igual, solo "Iniciar teleconsulta" se degrada a "no
# disponible". Nunca subas la clave real al repo.
# DAILY_API_KEY=
# DAILY_API_BASE_URL=https://api.daily.co/v1
