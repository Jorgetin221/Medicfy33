# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development

# Where the backend API is running. Defaults to http://localhost:3001
# if unset (see apps/web/src/lib/api-client.ts) — only needed here to
# point at a different backend (staging, a teammate's machine, etc).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
